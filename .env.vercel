# ==============================================================================
# MediQueue — Vercel Serverless Production Environment Configuration
# Copy/paste the contents of this file directly into Vercel Dashboard:
# Settings -> Environment Variables
# ==============================================================================

APP_NAME=MediQueue
APP_ENV=production
APP_KEY=base64:kCkNSwihlFVDA97qozR5yDW83gBJlkiYC0DOJ3UP7Aw=
APP_DEBUG=false
APP_URL=https://medi-queue-pmdd.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Vercel automatically streams stderr into Runtime Function Logs)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL Database Connection
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=ep-quiet-lake-aw5dfgql-pooler.c-12.us-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_jYdOW8Xka6FK
DB_SSLMODE=require

# Full Connection URL (optional alternative)
DATABASE_URL=postgresql://neondb_owner:npg_jYdOW8Xka6FK@ep-quiet-lake-aw5dfgql-pooler.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Serverless Session & Cache (Cookie/Array to avoid read-only disk limitations)
# ------------------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Temporary writable paths for Vercel Lambdas
VIEW_COMPILED_PATH=/tmp/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php

# ------------------------------------------------------------------------------
# Mail Notification Gateway (Zoho SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=hello@johnokyere.xyz
MAIL_PASSWORD=Mhiskall9090@
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@johnokyere.xyz"
MAIL_FROM_NAME="MediQueue Appointments"

VITE_APP_NAME="${APP_NAME}"
