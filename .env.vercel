# ==============================================================================
# MediQueue — Vercel Serverless Production Environment Configuration
# Copy/paste the contents of this file directly into Vercel Dashboard:
# Project Settings -> Environment Variables
# ==============================================================================

APP_NAME=MediQueue
APP_ENV=production
APP_KEY=base64:kCkNSwihlFVDA97qozR5yDW83gBJlkiYC0DOJ3UP7Aw=
APP_DEBUG=false
APP_URL=https://your-mediqueue-app.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Vercel automatically collects stderr into Runtime Function Logs)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database: Neon.tech / Supabase PostgreSQL (Free Cloud DB)
# Replace with your actual Neon/Supabase database host, database, user, & password
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=ep-cool-sample-123456.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_db_password
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Serverless Storage & State Handlers
# Cookie sessions and in-memory caches avoid read-only disk limitations
# ------------------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Temporary writable paths for Vercel Lambdas
VIEW_COMPILED_PATH=/tmp/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php

# ------------------------------------------------------------------------------
# Mail Notification Gateway (Zoho SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=hello@johnokyere.xyz
MAIL_PASSWORD=Mhiskall9090@
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@johnokyere.xyz"
MAIL_FROM_NAME="MediQueue Appointments"

VITE_APP_NAME="${APP_NAME}"
